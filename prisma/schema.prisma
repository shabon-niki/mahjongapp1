// 聴牌 データモデル
// Account → Group → JOIN → PLAY & LEARN → RANKING

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExperienceLevel {
  inexperienced // 未経験
  beginner // 初心者
  experienced // 経験者
}

model User {
  id              String          @id @default(cuid())
  name            String
  /// ログインに使うメールアドレス。ゲストユーザー(isGuest=true)はnullのままでよい。
  email           String?         @unique
  avatarUrl       String?         @map("avatar_url")
  /// ログインパスワードのハッシュ。ゲストユーザー(isGuest=true)はnullのままでよい。
  passwordHash    String?         @map("password_hash")
  experienceLevel ExperienceLevel @default(beginner) @map("experience_level")
  /// 対局記録にその場限りで追加されるゲスト参加者。ログイン不可・ランキング集計対象外。
  isGuest         Boolean         @default(false) @map("is_guest")
  /// アカウント削除日時(nullなら有効)。過去の対局結果・ランキング履歴は他メンバーの
  /// データと不可分のため削除せず、email/passwordHashをnull化してログイン不可にするのみ。
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  memberships      GroupMembership[]
  ownedGroups      Group[]           @relation("OwnedGroups")
  organizedEvents  Event[]           @relation("OrganizedEvents")
  entries          Entry[]
  createdGames     Game[]            @relation("CreatedGames")
  gameResults      GameResult[]
  createdTables    Table[]           @relation("CreatedTables")
  tableMemberships TableMember[]     @relation("TableMemberships")

  @@map("users")
}

enum MembershipRole {
  owner
  member
}

model Group {
  id               String   @id @default(cuid())
  name             String
  imageUrl         String?  @map("image_url")
  ownerUserId      String   @map("owner_user_id")
  /// シーズン開始月(1-12)。9月開始をアプリ全体にハードコードしないための設定値。
  seasonStartMonth Int      @default(9) @map("season_start_month")
  rankingEnabled   Boolean  @default(true) @map("ranking_enabled")
  /// 招待リンク用トークン。Ownerが再発行(ローテーション)可能。
  inviteToken      String   @unique @default(cuid())
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner       User               @relation("OwnedGroups", fields: [ownerUserId], references: [id])
  memberships GroupMembership[]
  events      Event[]
  games       Game[]
  tables      Table[]
  rule        GroupRule?

  @@map("groups")
}

model GroupMembership {
  id       String         @id @default(cuid())
  groupId  String         @map("group_id")
  userId   String         @map("user_id")
  role     MembershipRole @default(member)
  joinedAt DateTime       @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_memberships")
}

/**
 * Group単位の麻雀ルール設定。TimewitchやGroup毎の正式ルールは不明なため、
 * Ownerが設定できる構造にとどめ、値を勝手に確定しない(仕様16, 50章)。
 */
model GroupRule {
  id      String @id @default(cuid())
  groupId String @unique @map("group_id")

  startingPoints Int @default(25000) @map("starting_points")

  umaFirst  Int @default(20) @map("uma_first")
  umaSecond Int @default(10) @map("uma_second")
  umaThird  Int @default(-10) @map("uma_third")
  umaFourth Int @default(-20) @map("uma_fourth")

  okaEnabled Boolean @default(true) @map("oka_enabled")
  /// 1位に加算される点数(素点換算前, 例: 5000点)。okaEnabled=falseの場合は無視される。
  okaPoints  Int     @default(5000) @map("oka_points")

  chipEnabled Boolean @default(false) @map("chip_enabled")
  chipValue   Int     @default(1000) @map("chip_value")

  redDoraChipEnabled Boolean @default(false) @map("red_dora_chip_enabled")
  ippatsuChipEnabled Boolean @default(false) @map("ippatsu_chip_enabled")
  uraDoraChipEnabled Boolean @default(false) @map("ura_dora_chip_enabled")

  bustPenaltyEnabled Boolean @default(false) @map("bust_penalty_enabled")
  bustPenaltyValue   Int     @default(0) @map("bust_penalty_value")

  yakitoriEnabled Boolean @default(false) @map("yakitori_enabled")

  /// 期間内の対局数(半荘数)が多い/少ない人に加減点する「対局数ボーナス」の設定。
  /// 対局数TOP3に上から順にplayCountBonusTop1〜3、WORST3に上から順に
  /// playCountPenaltyWorst1〜3を加算する(通常はWorst側を負の値にする)。
  playCountBonusEnabled  Boolean @default(false) @map("play_count_bonus_enabled")
  playCountBonusTop1     Int     @default(3) @map("play_count_bonus_top1")
  playCountBonusTop2     Int     @default(2) @map("play_count_bonus_top2")
  playCountBonusTop3     Int     @default(1) @map("play_count_bonus_top3")
  playCountPenaltyWorst1 Int     @default(-3) @map("play_count_penalty_worst1")
  playCountPenaltyWorst2 Int     @default(-2) @map("play_count_penalty_worst2")
  playCountPenaltyWorst3 Int     @default(-1) @map("play_count_penalty_worst3")

  /// "asis"(そのまま/小数点第一位) | "gosha_rokunyu"(五捨六入) 素点計算の端数処理
  roundingRule String @default("asis") @map("rounding_rule")
  /// "seat_order" | "shared_rank" (同点時の順位決定方式)
  tieRule      String @default("seat_order") @map("tie_rule")
  /// "all_members"(参加者は誰でも編集可能) | "owner_only"(管理者のみ編集可能)
  resultEntryPermission String @default("all_members") @map("result_entry_permission")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id])

  @@map("group_rules")
}

enum EventStatus {
  open // 募集中
  closed // 締切済み(募集者の確定待ち)
  finalized // 参加者確定済み
  completed // 対局完了
}

model Event {
  id               String      @id @default(cuid())
  groupId          String      @map("group_id")
  title            String
  organizerUserId  String      @map("organizer_user_id")
  eventDatetime    DateTime    @map("event_datetime")
  entryDeadline    DateTime    @map("entry_deadline")
  maxTables        Int         @map("max_tables")
  beginnerFriendly Boolean     @default(false) @map("beginner_friendly")
  note             String?
  status           EventStatus @default(open)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  group     Group   @relation(fields: [groupId], references: [id])
  organizer User    @relation("OrganizedEvents", fields: [organizerUserId], references: [id])
  entries   Entry[]
  games     Game[]

  @@map("events")
}

enum EntryStatus {
  entered // 参加希望
  cancelled // 本人キャンセル
  selected // 参加者として選定済み
  not_selected // 参加希望したが選ばれなかった
  played // 実際に対局した
}

model Entry {
  id          String      @id @default(cuid())
  eventId     String      @map("event_id")
  userId      String      @map("user_id")
  status      EntryStatus @default(entered)
  enteredAt   DateTime    @default(now()) @map("entered_at")
  cancelledAt DateTime?   @map("cancelled_at")
  selectedAt  DateTime?   @map("selected_at")
  playedAt    DateTime?   @map("played_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("entries")
}

enum GameStatus {
  draft
  confirmed
  void
}

/**
 * 1半荘の対局。Event参加者とGame参加者は別概念であり、
 * eventIdはnullable(募集を経由しない対局も将来登録可能にするため)。
 */
model Game {
  id              String     @id @default(cuid())
  groupId         String     @map("group_id")
  eventId         String?    @map("event_id")
  tableId         String?    @map("table_id")
  /// 対局記録(Table)内での作成順の連番。表示順の安定ソートキーとして使う(削除後の欠番は詰めない)。
  hanchanNumber   Int?       @map("hanchan_number")
  playedAt        DateTime   @default(now()) @map("played_at")
  /// Game作成時点のGroupRuleのコピー。後でGroupRuleが変わっても過去Gameの結果は変化しない。
  ruleSnapshot    String     @map("rule_snapshot")
  status          GameStatus @default(draft)
  createdByUserId String     @map("created_by_user_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  group     Group        @relation(fields: [groupId], references: [id])
  event     Event?       @relation(fields: [eventId], references: [id])
  table     Table?       @relation(fields: [tableId], references: [id])
  createdBy User         @relation("CreatedGames", fields: [createdByUserId], references: [id])
  results   GameResult[]

  @@map("games")
}

enum TableStatus {
  open
  locked
}

/**
 * 対局記録。1回の集まりで打った複数半荘をまとめて記録する単位(クォーター単位の一覧の元になる)。
 * Event(募集)とは独立した並行機能で、募集を経由しない対局記録にも対応する。
 */
model Table {
  id              String      @id @default(cuid())
  groupId         String      @map("group_id")
  playedDate      DateTime    @map("played_date")
  status          TableStatus @default(open)
  createdByUserId String      @map("created_by_user_id")
  lockedAt        DateTime?   @map("locked_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  group     Group         @relation(fields: [groupId], references: [id])
  createdBy User          @relation("CreatedTables", fields: [createdByUserId], references: [id])
  members   TableMember[]
  games     Game[]

  @@map("tables")
}

/** 対局記録の面子(ロスター)。半荘ごとに実際に参加した4人はGameResultの行で決まる。 */
model TableMember {
  id        String   @id @default(cuid())
  tableId   String   @map("table_id")
  userId    String   @map("user_id")
  seatOrder Int      @map("seat_order")
  joinedAt  DateTime @default(now()) @map("joined_at")

  table Table @relation(fields: [tableId], references: [id])
  user  User  @relation("TableMemberships", fields: [userId], references: [id])

  @@unique([tableId, userId])
  @@map("table_members")
}

/**
 * 対局結果。totalだけでなく内訳(素点/ウマ/オカ/チップ/ペナルティ)を保持し、
 * なぜその結果になったかを後から説明できるようにする(仕様23章)。
 */
model GameResult {
  id                 String   @id @default(cuid())
  gameId             String   @map("game_id")
  userId             String   @map("user_id")
  seatOrder          Int      @map("seat_order")
  finalScore         Int      @map("final_score")
  rank               Int
  rawScorePoint       Float    @map("raw_score_point")
  umaPoint           Float    @map("uma_point")
  okaPoint           Float    @map("oka_point")
  chipCount          Int      @default(0) @map("chip_count")
  chipPoint          Float    @default(0) @map("chip_point")
  penaltyPoint       Float    @default(0) @map("penalty_point")
  totalRankingPoint  Float    @map("total_ranking_point")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@map("game_results")
}
